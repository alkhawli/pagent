# FastAPI
APP_NAME="PAGENT Untis Chatbot"
APP_HOST=127.0.0.1
APP_PORT=8020

# MCP server command. The default runs the upstream server directly from GitHub with uvx.
MCP_COMMAND=uvx
MCP_ARGS="--from git+https://github.com/kohlsalem/untis-mcp --with mcp<2 untis-mcp"
MCP_STARTUP_TIMEOUT_SECONDS=30

# WebUntis credentials consumed by the MCP server.
WEBUNTIS_SERVER=couven.webuntis.com
WEBUNTIS_SCHOOL=couven
WEBUNTIS_USER=your-username
WEBUNTIS_PASSWORD=your-password

# Azure AI Foundry project used by the chat agent (tool-calling via the Azure OpenAI-compatible API).
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_API_VERSION=2024-10-21

# Azure AI Foundry project + pre-built agent used for web-search (news/trends pages).
# AZURE_AI_PROJECT_ENDPOINT is the "Azure AI Project" endpoint shown in the Foundry portal
# Overview page (can be the same resource as AZURE_FOUNDRY_ENDPOINT above). FOUNDRY_AGENT_NAME/
# FOUNDRY_AGENT_VERSION reference a Foundry agent (already configured with its own web search
# tool) invoked via the agent_reference Responses API. Authenticates via DefaultAzureCredential
# (az login locally, managed identity in Azure).
AZURE_AI_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=personal-web
FOUNDRY_AGENT_VERSION=3

# Blob storage for dashboard/meal-plan JSON data (see terraform/main.tf app_storage).
# In Azure, the backend authenticates via its managed identity using just the account name:
AZURE_STORAGE_ACCOUNT_NAME=
# For local development only, you can instead point at a real/dev storage account or an
# Azurite emulator with a connection string (takes precedence over the account name above):
AZURE_STORAGE_CONNECTION_STRING=

# Schedule/Untis dashboard refresh (daily) and meal-plan refresh (weekly) cron times.
DASHBOARD_REFRESH_TIMES=06:30
MEAL_PLAN_REFRESH_DAY=fri
MEAL_PLAN_REFRESH_TIME=20:00

# News refresh (daily) and AI/GitHub trends refresh (weekly) cron times.
NEWS_REFRESH_TIME=07:00
TRENDS_REFRESH_DAY=mon
TRENDS_REFRESH_TIME=08:00

